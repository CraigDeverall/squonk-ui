# Ignore node_modules
node_modules

# Ignore build output
dist



# Ignore other common files and directories
.git
.gitignore
Dockerfile
.dockerignore
npm-debug.log
yarn-debug.log
yarn-error.log
# Local credentials and private keys are never build inputs.
**/.env*
**/.aws
**/.ssh
**/*.pem
**/*.key
**/*.p12
**/*.pfx

**/node_modules

# Squonk: CI and agent scratch never enter an image.
**/.agents
**/.codex
.docker-ci
