  "bin": {
    "squonk-ui": "bin/squonk-ui.mjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && rollup -c && node scripts/finalize-declarations.mjs && cp src/fonts.css dist/fonts.css && cp public/design-catalog.json dist/design-catalog.json && cp public/design-guides.json dist/design-guides.json && node scripts/build-stories.mjs",
    "prebuild": "rm -rf dist && node scripts/generate-package-exports.mjs && node scripts/generate-tokens-css.mjs --check",
    "lint": "eslint . && node scripts/check-purpose-tokens.mjs",
    "dev": "storybook dev -p 6006",
    "build-storybook": "storybook build && node scripts/storybook-site-title.mjs && node scripts/generate-sitemap.mjs",
    "pretest": "node scripts/check-docker.mjs",
    "test": "./test-setup/storybook-test.sh",
    "pretest:update": "node scripts/check-docker.mjs",
    "test:update": "UPDATE_SNAPSHOTS=true ./test-setup/storybook-test.sh",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "show-report": "npx playwright show-report",
    "prepare": "husky || true",
    "pre-commit": "lint-staged && tsc --noEmit",
    "generate": "yo ./generators/component",
    "test:package": "node scripts/check-packed-consumers.mjs",
    "test:scripts": "node --test scripts/*.test.mjs eslint/*.test.mjs bin/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "test:generator": "node --test generators/component/generator.test.mjs",
    "check:secrets": "node scripts/check-source-secrets.mjs",
    "audit:dependencies": "node scripts/check-dependency-audit.mjs",
    "catalog:generate": "node scripts/design-catalog.mjs",
    "catalog:check": "node scripts/design-catalog.mjs --check",
    "tokens:generate": "node scripts/generate-tokens-css.mjs",
    "tokens:check": "node scripts/generate-tokens-css.mjs --check"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CraigDeverall/squonk-ui.git"
  },
  "dependencies": {
