{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "../..",
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "@controller/*": ["../../.storybook/addons/theme-controller/*"],
      "@theme/*": ["../../src/theme/*"],
      "@src/*": ["../../src/*"],
      "@components/*": ["../../src/components/*"],
      "@hooks/*": ["../../src/hooks/*"],
      "@utils/*": ["../../src/utils/*"],
      "@root/*": ["../../*"]
    }
  },
  "include": ["src", "test/fixture", "vite.config.ts", "../../.storybook/vite-env.d.ts", "../../.storybook/types.d.ts", "../../src/types/*"],
  "exclude": ["dist"]
}
